        {
            "name": "2. Login",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"ananya@greenbasket.in\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                    "raw": "http://localhost/StockSense_backend/auth/login.php",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "path": [
                        "StockSense_backend",
                        "auth",
                        "login.php"
                    ]
                },
                "description": "Authenticates the store owner and returns account details (ID, name, shop name, location, store type, currency, email)."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "var jsonData = pm.response.json();",
                            "pm.test(\"Login returns valid 64-char token\", function () {",
                            "    pm.expect(jsonData.success).to.eql(true);",
                            "    pm.expect(jsonData.token).to.be.a(\"string\");",
                            "    pm.expect(jsonData.token.length).to.eql(64);",
                            "});",
                            "",
                            "if (jsonData.token) {",
                            "    pm.collectionVariables.set(\"token\", jsonData.token);",
                            "    console.log(\"Updated collection variable 'token': \" + jsonData.token);",
                            "}"
                        ]
                    }
                }
            ]
        },
