                    "name": "Get User Settings",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/auth/get_settings.php?email={{auth_email}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "get_settings.php"
                            ],
                            "query": [
                                {
                                    "key": "email",
                                    "value": "{{auth_email}}"
