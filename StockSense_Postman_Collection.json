    "item": [
        {
            "name": "1. Authentication",
            "item": [
                {
                    "name": "Signup (Create Account)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"full_name\": \"Ananya Rao\",\n  \"shop_name\": \"Green Basket\",\n  \"location\": \"Indiranagar, Bengaluru\",\n  \"store_type\": \"Neighbourhood supermarket\",\n  \"currency\": \"\u20b9 INR / IST\",\n  \"email\": \"{{auth_email}}\",\n  \"password\": \"{{auth_password}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/signup.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "signup.php"
                            ]
                        },
                        "description": "Registers a new store owner account, sets initial store details, and generates default settings automatically."
                    }
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{auth_email}}\",\n  \"password\": \"{{auth_password}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/login.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "login.php"
                            ]
                        },
                        "description": "Authenticates the store owner and returns account details (ID, full name, shop name, location, store type, currency, and email)."
                    }
                },
                {
                    "name": "Forgot Password - Verify Email",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
