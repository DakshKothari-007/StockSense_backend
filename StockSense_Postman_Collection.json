                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "profile.php"
                            ],
                            "query": [
                                {
                                    "key": "email",
                                    "value": "{{auth_email}}",
                                    "description": "Lookup by email or pass ?id=1"
