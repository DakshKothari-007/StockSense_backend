                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{auth_email}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/forgot_password.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "forgot_password.php"
                            ]
                        },
                        "description": "Step 1 of password recovery: Checks if the user email exists in the system."
                    }
                },
                {
                    "name": "Reset Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{auth_email}}\",\n  \"new_password\": \"brandnewpass123\",\n  \"confirm_password\": \"brandnewpass123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/reset_password.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "reset_password.php"
                            ]
                        },
                        "description": "Step 2 of password recovery matching ForgotPasswordScreen: sets the new password directly for the given email."
                    }
                },
                {
                    "name": "Logout / Sign Out",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{auth_email}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/logout.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "logout.php"
                            ]
                        },
                        "description": "Logs out the user and clears server session if active."
                    }
                }
            ]
        },
        {
            "name": "2. Profile & Shop Management",
            "item": [
                {
                    "name": "Get Profile",
                    "request": {
                        "method": "GET",
                        "header": [],
