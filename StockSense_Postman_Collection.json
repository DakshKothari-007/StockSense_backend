                    }
                }
            ]
        },
        {
            "name": "4. Inventory Management",
            "item": [
                {
                    "name": "Get All Products (Filter & Live Search)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/inventory/get_products.php?filter=all&search=",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "inventory",
                                "get_products.php"
                            ],
                            "query": [
                                {
                                    "key": "filter",
                                    "value": "all",
                                    "description": "Options: all (0), low_stock (1), slow_moving (2)"
                                },
                                {
                                    "key": "search",
                                    "value": "",
                                    "description": "Optional search string (matches name or SKU)"
                                }
                            ]
                        },
                        "description": "Retrieves the product list for InventoryScreen with filter tabs (All, Low Stock, Slow Moving) and live search query."
                    }
                },
                {
                    "name": "Get Single Product Detail",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/inventory/get_product_detail.php?sku={{sample_sku}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "inventory",
                                "get_product_detail.php"
                            ],
                            "query": [
                                {
                                    "key": "sku",
                                    "value": "{{sample_sku}}",
                                    "description": "Look up by SKU or pass ?id=1"
                                }
                            ]
                        },
                        "description": "Fetches item details, current units, pricing, cost price, and calculated AI reorder insights for ProductDetailScreen."
                    }
                },
                {
                    "name": "Add New Product",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Fortune Sunflower Oil \u00b7 1 L\",\n  \"sku\": \"OIL-005\",\n  \"category\": \"Staples\",\n  \"description\": \"1 L pouch \u00b7 Refined oil\",\n  \"price\": 145.00,\n  \"cost_price\": 120.00,\n  \"units\": 50,\n  \"min_stock_threshold\": 15,\n  \"icon_type\": 2\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/inventory/add_product.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "inventory",
                                "add_product.php"
                            ]
                        },
                        "description": "Inserts a new product into the shop inventory with duplicate SKU prevention."
                    }
                },
                {
                    "name": "Update Product Details / Units",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"sku\": \"{{sample_sku}}\",\n  \"units\": 68,\n  \"price\": 32.00,\n  \"cost_price\": 27.00,\n  \"min_stock_threshold\": 24\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/inventory/update_product.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "inventory",
                                "update_product.php"
                            ]
                        },
                        "description": "Updates stock quantity (units), selling price, cost price, or threshold for an existing product."
                    }
                },
                {
                    "name": "Bulk Import Inventory Data",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"mode\": \"add_units\",\n  \"items\": [\n    {\n      \"name\": \"Surf Excel - 500 g\",\n      \"sku\": \"HOM-021\",\n      \"category\": \"Home care\",\n      \"price\": 65.00,\n      \"cost_price\": 58.00,\n      \"units\": 20\n    },\n    {\n      \"name\": \"Amul Milk - 500 ml\",\n      \"sku\": \"DAI-001\",\n      \"units\": 60,\n      \"price\": 30.00,\n      \"cost_price\": 27.00\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/inventory/import_inventory.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "inventory",
                                "import_inventory.php"
                            ]
                        },
                        "description": "Imports batch product data. Mode can be 'add_units' (increments existing units) or 'set_units' (overwrites stock count)."
                    }
                },
                {
                    "name": "Delete Product",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"sku\": \"OIL-005\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/inventory/delete_product.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "inventory",
                                "delete_product.php"
                            ]
                        },
                        "description": "Deletes a product by SKU or ID, scoped strictly to the authenticated shop owner."
                    }
                }
            ]
        },
        {
            "name": "4. Import Module (Spreadsheet & Stock Receipt)",
            "item": [
                {
                    "name": "1. Upload Spreadsheet File (CSV/XLSX)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "file",
                                    "type": "file",
                                    "src": "sample_valid_import.csv",
                                    "description": "Select a .csv or .xlsx stock spreadsheet file (up to 5 MB)"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/import/upload.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "import",
                                "upload.php"
                            ]
                        },
                        "description": "Uploads a CSV or Excel (.xlsx) stock spreadsheet (up to 5 MB). Detects headers, generates initial 5-row preview, suggests 5-column mappings, and generates a session file_token."
                    }
                },
                {
                    "name": "2. Preview Column Mapping & Table Rows",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"file_token\": \"{{file_token}}\",\n  \"column_mapping\": {\n    \"sku\": \"SKU\",\n    \"name\": \"Product\",\n    \"units\": \"Quantity\",\n    \"cost_price\": \"Cost\",\n    \"price\": \"Price\"\n  }\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/import/preview.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "import",
                                "preview.php"
                            ]
                        },
                        "description": "Previews all mapped rows with current store stock levels, calculated selling price string, unit costs, and highlight indicators for potential errors before validation."
                    }
                },
                {
                    "name": "3. Validate Rows & Flag Errors",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"file_token\": \"{{file_token}}\",\n  \"column_mapping\": {\n    \"sku\": \"SKU\",\n    \"name\": \"Product\",\n    \"units\": \"Quantity\",\n    \"cost_price\": \"Cost\",\n    \"price\": \"Price\"\n  },\n  \"corrections\": [\n    {\n      \"row_number\": 4,\n      \"field\": \"units\",\n      \"value\": 18\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/import/validate.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "import",
                                "validate.php"
                            ]
                        },
                        "description": "Validates every spreadsheet row. Detects stray letters (e.g. '18O' instead of 18), missing SKUs, or negative values. Returns detailed error badges, reasons, and suggested corrections. When all rows are valid, returns stock preview calculation (current + add = new stock) and inventory value to add."
                    }
                },
                {
                    "name": "4. Execute Import (Atomic Transaction)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"file_token\": \"{{file_token}}\",\n  \"file_name\": \"stock_oct15.xlsx\",\n  \"allow_partial\": false,\n  \"corrections\": [\n    {\n      \"row_number\": 4,\n      \"field\": \"units\",\n      \"value\": 18\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/import/execute.php",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "import",
                                "execute.php"
                            ]
                        },
                        "description": "Executes database transaction. Existing SKUs have their units incremented (stock receipt), new SKUs create new products. If any invalid rows remain and allow_partial is false, transaction rolls back completely (HTTP 422). Logs completed/failed import to import_history."
                    }
                },
                {
                    "name": "5. Get Import History Logs",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/import/get_history.php?limit=20&offset=0",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "import",
                                "get_history.php"
                            ],
                            "query": [
                                {
                                    "key": "limit",
                                    "value": "20"
                                },
                                {
                                    "key": "offset",
                                    "value": "0"
                                }
                            ]
                        },
                        "description": "Fetches historical import logs for the authenticated store owner with file name, file size, status, total rows, success/failed count, and summary details."
                    }
                }
            ]
        }
    ]
}